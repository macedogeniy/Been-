# ==============================================================================
# 🎯 Конфигурация торговой системы "Охота за ликвидностью"
# ==============================================================================
# Скопируйте этот файл в .env и заполните ваши данные

# ==============================================================================
# 🏦 НАСТРОЙКИ БИРЖИ
# ==============================================================================

# Название биржи (binance, bybit, okx, kraken и др.)
EXCHANGE_NAME=binance

# Режим песочницы (true для тестов, false для реальной торговли)
EXCHANGE_SANDBOX=true

# API ключи биржи (получите в личном кабинете биржи)
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_SECRET=your_secret_here
EXCHANGE_PASSPHRASE=your_passphrase_here

# Лимиты и таймауты
EXCHANGE_RATE_LIMIT=1200
EXCHANGE_TIMEOUT=30000

# ==============================================================================
# 📈 ТОРГОВЫЕ НАСТРОЙКИ
# ==============================================================================

# Основная торговая пара
TRADING_SYMBOL=BTC/USDT
TRADING_BASE_CURRENCY=USDT

# Максимальный риск на сделку (0.02 = 2%)
TRADING_MAX_RISK_PER_TRADE=0.02

# Максимальное количество открытых позиций
TRADING_MAX_OPEN_POSITIONS=3

# Мультипликаторы для стоп-лосса и тейк-профита
TRADING_STOP_LOSS_MULTIPLIER=1.5
TRADING_TAKE_PROFIT_MULTIPLIER=2.0

# Минимальное соотношение риск/прибыль
TRADING_MIN_RR_RATIO=2.0

# Минимальный скор конфлюенции для входа в сделку
TRADING_MIN_CONFLUENCE_SCORE=0.7

# Период для детекции свинг-точек
TRADING_SWING_DETECTION_PERIOD=5

# Буфер для детекции ликвидности
TRADING_LIQUIDITY_BUFFER=0.001

# ==============================================================================
# 🧪 НАСТРОЙКИ БЭК-ТЕСТИНГА
# ==============================================================================

# Период для бэк-тестинга
BACKTEST_START_DATE=2023-01-01
BACKTEST_END_DATE=2024-01-01

# Начальный баланс для тестирования
BACKTEST_INITIAL_BALANCE=10000.0

# Комиссия биржи (0.001 = 0.1%)
BACKTEST_COMMISSION=0.001

# Проскальзывание (0.0005 = 0.05%)
BACKTEST_SLIPPAGE=0.0005

# Настройки оптимизации параметров
BACKTEST_ENABLE_OPTIMIZATION=false
BACKTEST_OPTIMIZATION_METRIC=sharpe_ratio
BACKTEST_MAX_WORKERS=4

# ==============================================================================
# 🧪 НАСТРОЙКИ ДАННЫХ
# ==============================================================================

# Путь к данным
DATA_DATA_PATH=data

# Размер кэша
DATA_CACHE_SIZE=1000

# Интервал обновления данных (секунды)
DATA_REFRESH_INTERVAL=60

# URL базы данных
DATA_DB_URL=sqlite:///data/trading_system.db
DATA_DB_POOL_SIZE=5

# Настройки кэширования
DATA_ENABLE_CACHE=true
DATA_CACHE_TTL=300

# ==============================================================================
# 📝 НАСТРОЙКИ ЛОГИРОВАНИЯ
# ==============================================================================

# Уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOGGING_LEVEL=INFO

# Путь к логам
LOGGING_LOG_PATH=logs

# Максимальный размер файла лога
LOGGING_MAX_SIZE=100 MB

# Период хранения логов
LOGGING_RETENTION=30 days

# Включить метрики
LOGGING_ENABLE_METRICS=true
LOGGING_METRICS_INTERVAL=60

# ==============================================================================
# 🎨 НАСТРОЙКИ ВИЗУАЛИЗАЦИИ
# ==============================================================================

# Размеры графиков
VIZ_CHART_WIDTH=1200
VIZ_CHART_HEIGHT=800

# Тема оформления (plotly_dark, plotly_white, ggplot2, seaborn)
VIZ_THEME=plotly_dark

# Настройки веб-интерфейса
VIZ_HOST=localhost
VIZ_PORT=8501
VIZ_DEBUG=false

# ==============================================================================
# 🎯 НАСТРОЙКИ СТРАТЕГИИ "ОХОТА ЗА ЛИКВИДНОСТЬЮ"
# ==============================================================================

# Чувствительность детекции ликвидности
STRATEGY_LIQUIDITY_SENSITIVITY=0.8

# Минимальный возраст свинга (в барах)
STRATEGY_MIN_LIQUIDITY_AGE=5

# Максимальное расстояние до ликвидности
STRATEGY_MAX_LIQUIDITY_DISTANCE=0.02

# Период валидности Order Blocks (в барах)
STRATEGY_OB_VALIDITY_PERIOD=50

# Минимальный размер тела свечи для OB
STRATEGY_OB_MIN_BODY_RATIO=0.6

# Минимальный размер Fair Value Gap
STRATEGY_FVG_MIN_SIZE=0.001

# Период валидности FVG (в барах)
STRATEGY_FVG_VALIDITY_PERIOD=30

# Количество баров для подтверждения структуры
STRATEGY_STRUCTURE_CONFIRMATION_BARS=3

# Минимальное количество свингов для тренда
STRATEGY_TREND_MIN_SWINGS=3

# Граница premium/discount
STRATEGY_PREMIUM_DISCOUNT_THRESHOLD=0.5

# Факторы адаптации и человекоподобного мышления
STRATEGY_ADAPTATION_FACTOR=0.1
STRATEGY_EMOTION_WEIGHT=0.05
STRATEGY_CONTEXT_MEMORY_LENGTH=20

# ==============================================================================
# 🚨 НАСТРОЙКИ УВЕДОМЛЕНИЙ (ОПЦИОНАЛЬНО)
# ==============================================================================

# Email уведомления
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_SMTP_SERVER=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_USERNAME=your_email@gmail.com
ALERT_EMAIL_PASSWORD=your_app_password
ALERT_EMAIL_FROM=your_email@gmail.com
ALERT_EMAIL_TO=your_email@gmail.com

# Telegram уведомления
ALERT_TELEGRAM_ENABLED=false
ALERT_TELEGRAM_BOT_TOKEN=your_bot_token
ALERT_TELEGRAM_CHAT_ID=your_chat_id

# Webhook уведомления
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ==============================================================================
# 🛠️ СИСТЕМНЫЕ НАСТРОЙКИ
# ==============================================================================

# Режим отладки
DEBUG_MODE=false

# Максимальное использование памяти (MB)
MAX_MEMORY_USAGE=4096

# Включить профилирование производительности
ENABLE_PROFILING=false

# ==============================================================================
# 📚 ИНСТРУКЦИИ ПО НАСТРОЙКЕ
# ==============================================================================

# 1. Скопируйте этот файл в .env:
#    cp .env.example .env

# 2. Зарегистрируйтесь на бирже и получите API ключи:
#    - Binance: https://www.binance.com/en/my/settings/api-management
#    - Bybit: https://www.bybit.com/app/user/api-management
#    - OKX: https://www.okx.com/account/my-api

# 3. Установите зависимости:
#    pip install -r requirements.txt

# 4. Запустите систему:
#    python main.py

# 5. Для веб-интерфейса:
#    python run_dashboard.py

# ⚠️  ВАЖНО: НЕ КОММИТЬТЕ ФАЙЛ .env В GIT!
# Добавьте .env в .gitignore для безопасности ваших API ключей