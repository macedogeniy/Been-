# Конфигурация торговой системы "Охота за ликвидностью"

# =============================================================================
# НАСТРОЙКИ БИРЖИ
# =============================================================================
EXCHANGE_NAME=binance
EXCHANGE_SANDBOX=true
EXCHANGE_API_KEY=your_binance_api_key_here
EXCHANGE_SECRET=your_binance_secret_here
EXCHANGE_RATE_LIMIT=1200
EXCHANGE_TIMEOUT=30000

# =============================================================================
# ТОРГОВЫЕ НАСТРОЙКИ
# =============================================================================
TRADING_SYMBOL=BTC/USDT
TRADING_MAX_RISK_PER_TRADE=0.02
TRADING_MAX_OPEN_POSITIONS=3
TRADING_MIN_RR_RATIO=2.0
TRADING_MIN_CONFLUENCE_SCORE=0.7
TRADING_SWING_DETECTION_PERIOD=5

# =============================================================================
# НАСТРОЙКИ ДАННЫХ
# =============================================================================
DATA_CACHE_TTL=300
DATA_ENABLE_CACHE=true
DATA_CACHE_SIZE=1000
DATA_REFRESH_INTERVAL=60

# =============================================================================
# НАСТРОЙКИ БЭК-ТЕСТИНГА
# =============================================================================
BACKTEST_START_DATE=2023-01-01
BACKTEST_END_DATE=2024-01-01
BACKTEST_INITIAL_BALANCE=10000.0
BACKTEST_COMMISSION=0.001
BACKTEST_SLIPPAGE=0.0005

# =============================================================================
# НАСТРОЙКИ СТРАТЕГИИ
# =============================================================================
STRATEGY_LIQUIDITY_SENSITIVITY=0.8
STRATEGY_MIN_LIQUIDITY_AGE=5
STRATEGY_MAX_LIQUIDITY_DISTANCE=0.02
STRATEGY_OB_VALIDITY_PERIOD=50
STRATEGY_FVG_MIN_SIZE=0.001
STRATEGY_ADAPTATION_FACTOR=0.1
STRATEGY_EMOTION_WEIGHT=0.05

# =============================================================================
# НАСТРОЙКИ ЛОГИРОВАНИЯ
# =============================================================================
LOGGING_LEVEL=INFO
LOGGING_MAX_SIZE=100 MB
LOGGING_RETENTION=30 days

# =============================================================================
# НАСТРОЙКИ ВИЗУАЛИЗАЦИИ
# =============================================================================
VIZ_HOST=localhost
VIZ_PORT=8050
VIZ_DEBUG=false
VIZ_THEME=plotly_dark